class PetAnimal {
    String name;
    String place;
    String food;
    String sound;

    PetAnimal(String name, String place, String food, String sound) {
        this.name = name;
        this.place = place;
        this.food = food;
        this.sound = sound;
    }

    void display() {
        System.out.println("Animal : " + name);
        System.out.println("Where it stays : " + place);
        System.out.println("What it eats : " + food);
        System.out.println("Sound : " + sound);
        System.out.println();
    }
}

public class PetAnimals {
    public static void main(String[] args) {

        PetAnimal dog = new PetAnimal(
            "Dog", "Kennel", "Meat", "Bark");

        PetAnimal cat = new PetAnimal(
            "Cat", "House", "Fish", "Meow");

        PetAnimal rabbit = new PetAnimal(
            "Rabbit", "Burrow", "Carrot", "Squeak");

        dog.display();
        cat.display();
        rabbit.display();
    }
}
